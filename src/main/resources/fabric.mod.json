{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contributors": [
    "ZurrTum (Create Fly)"
  ],
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.gravisludio.flyconfigmenu.client.ConfigMenuClient"
    ],
    "modmenu": [
      "com.gravisludio.flyconfigmenu.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "create_fly_config_menu.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-rendering-v1": "*",
    "fabric-screen-api-v1": "*",
    "create": "${create_version_range}"
  }
}
